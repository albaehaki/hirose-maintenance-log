# Salin file ini jadi .env lalu sesuaikan: cp .env.example .env
POSTGRES_USER=hirose
POSTGRES_PASSWORD=hirose_dev_password
POSTGRES_DB=hirose
POSTGRES_PORT=5432

# Diisi otomatis oleh compose memakai variabel di atas (host "db" = service compose)
DATABASE_URL=postgres://hirose:hirose_dev_password@db:5432/hirose

API_PORT=3000
WEB_PORT=8080
NODE_ENV=production
