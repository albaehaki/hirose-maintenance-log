# Normalisasi line ending: file yang dijalankan di Linux container
# (Docker/Alpine) WAJIB LF. Tanpa ini, checkout di Windows menghasilkan CRLF
# dan container gagal start ("entrypoint.sh: not found").
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
Jenkinsfile text eol=lf
nginx.conf text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yaml text eol=lf
